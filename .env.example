# RemoteBot Environment Configuration
PROJECT_NAME="RemoteBot — Real-Time Teleoperation & Network Simulator"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///./remotebot.db

# Simulation & Telemetry Loop Frequencies
SIMULATION_HZ=50
TELEMETRY_HZ=20
WATCHDOG_TIMEOUT_SEC=0.6
CONTROL_LEASE_TIMEOUT_SEC=30.0

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
